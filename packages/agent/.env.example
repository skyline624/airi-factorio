# --- LLM provider (OpenAI-compatible) ---
# The agent relies on FUNCTION CALLING and reliable JSON output: pick a model that
# supports both (many small local models do not).
#
# OpenAI (default): leave OPENAI_API_BASEURL empty and set a real key.
# Local / open-source via an OpenAI-compatible server: set OPENAI_API_BASEURL and
# OPENAI_MODEL; the key can be any non-empty placeholder.
#   Ollama:    OPENAI_API_BASEURL='http://localhost:11434/v1'  OPENAI_MODEL='qwen2.5'
#   LM Studio: OPENAI_API_BASEURL='http://localhost:1234/v1'
#   vLLM:      OPENAI_API_BASEURL='http://localhost:8000/v1'
OPENAI_API_KEY=''
OPENAI_API_BASEURL=''
OPENAI_MODEL='gpt-4o'

# --- Factorio RCON (native, no Docker) ---
# The agent speaks the Source-RCON protocol straight to the Factorio server's RCON
# port — no factorio-rcon-api / Docker proxy needed. Start the server with
#   --rcon-port 27015 --rcon-password <password>
# (or the equivalent in server settings) and match RCON_PASSWORD below.
RCON_HOST='localhost'
RCON_PORT=27015
RCON_PASSWORD=''

FACTORIO_WS_PORT=8080
FACTORIO_WS_HOST=''

# --- Factorio player to control ---
# In-game name of the player the agent drives. Empty = auto-detect the first
# connected player. Set this when the agent boots before a human joins, or when
# multiple humans play on the same server (so the agent picks the right one).
FACTORIO_PLAYER_NAME=''

# --- Debug ---
# When true, the agent broadcasts its action messages in the in-game chat
# (new objectives, success/failure summaries, autonomous decisions). When
# false, the chat stays quiet and the agent only replies when spoken to.
# Node-side logs are unaffected.
DEBUG_AGENT_SAY=false

# --- AIRI "general" bridge (optional) ---
# Connect the agent to the AIRI desktop app, which acts as the strategic "general":
# it receives status/alerts (spark:notify / context:update) and issues orders
# (spark:command) that the agent executes like a chat message from its master.
# Leave AIRI_ENABLED=false (default) to run the agent fully standalone.
#   AIRI_WS_URL:   the desktop app embeds the hub on ws://localhost:6121/ws
#   AIRI_WS_TOKEN: AIRI Settings → Connection (QR card), or server-channel-config.json
AIRI_ENABLED=false
AIRI_WS_URL='ws://localhost:6121/ws'
AIRI_MODULE_NAME='factorio'
AIRI_WS_TOKEN=''

# --- Operating mode ---
# Three modes, in order of precedence: LEARNING > AUTONOMOUS > reactive.
# Leave both flags false (default) for the reactive mode: the agent only acts
# when spoken to in the in-game chat (or via the AIRI bridge).

# --- Autonomous play mode (optional) ---
# The agent drives itself toward AUTONOMOUS_GOAL with no human task required:
# it observes, decides and acts on a fixed tick.
#   AUTONOMOUS_VISION=true sends a screenshot to a vision model each turn
#   (needs a connected client to capture the POV); otherwise it decides from text.
AUTONOMOUS_MODE=false
AUTONOMOUS_GOAL='Automate iron plate production: secure a small base, mine iron ore and coal, place burner mining drills on ore patches and stone furnaces next to them, fuel everything with coal, and accumulate at least 50 iron plates.'
AUTONOMOUS_TICK_DELAY_MS=1500
AUTONOMOUS_VISION=false
AUTONOMOUS_VISION_MODEL='gemma4:31b-cloud'

# --- Learning mode (Voyager-inspired, optional) ---
# The agent WRITES & runs skill code in a sandbox, builds a skill library, and a
# critic judges each attempt. Takes precedence over the modes above when enabled.
#   LEARNING_CURRICULUM=true: an auto-curriculum proposes objectives toward
#     LEARNING_GOAL; false: it runs the fixed '|'-separated LEARNING_OBJECTIVE list.
#   LEARNING_ACTION_MODEL / LEARNING_CRITIC_MODEL: empty = fall back to OPENAI_MODEL.
#   LEARNING_EMBEDDING_BASEURL: empty = fall back to OPENAI_API_BASEURL.
LEARNING_MODE=false
LEARNING_CURRICULUM=true
LEARNING_GOAL='Launch a rocket.'
LEARNING_MAX_OBJECTIVES=6
LEARNING_OBJECTIVE='Mine 10 iron ore and 5 coal.'
LEARNING_ACTION_MODEL=''
LEARNING_CRITIC_MODEL=''
LEARNING_EMBEDDING_MODEL='qwen3-embedding:8b'
LEARNING_EMBEDDING_BASEURL=''
LEARNING_SKILLS_DIR='./skills'
LEARNING_SANDBOX_TIMEOUT_MS=120000
LEARNING_SETTLE_TIMEOUT_MS=60000
LEARNING_MAX_OPS=200
LEARNING_MAX_RETRIES=4
