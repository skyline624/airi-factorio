# --- LLM provider (OpenAI-compatible) ---
# The agent relies on FUNCTION CALLING and reliable JSON output: pick a model that
# supports both (many small local models do not).
#
# OpenAI (default): leave OPENAI_API_BASEURL empty and set a real key.
# Local / open-source via an OpenAI-compatible server: set OPENAI_API_BASEURL and
# OPENAI_MODEL; the key can be any non-empty placeholder.
#   Ollama:    OPENAI_API_BASEURL='http://localhost:11434/v1'  OPENAI_MODEL='qwen2.5'
#   LM Studio: OPENAI_API_BASEURL='http://localhost:1234/v1'
#   vLLM:      OPENAI_API_BASEURL='http://localhost:8000/v1'
OPENAI_API_KEY=''
OPENAI_API_BASEURL=''
OPENAI_MODEL='gpt-4o'

# --- Factorio RCON (native, no Docker) ---
# The agent speaks the Source-RCON protocol straight to the Factorio server's RCON
# port — no factorio-rcon-api / Docker proxy needed. Start the server with
#   --rcon-port 27015 --rcon-password <password>
# (or the equivalent in server settings) and match RCON_PASSWORD below.
RCON_HOST='localhost'
RCON_PORT=27015
RCON_PASSWORD=''

FACTORIO_WS_PORT=8080
FACTORIO_WS_HOST=''

# --- AIRI "general" bridge (optional) ---
# Connect the agent to the AIRI desktop app, which acts as the strategic "general":
# it receives status/alerts (spark:notify / context:update) and issues orders
# (spark:command) that the agent executes like a chat message from its master.
# Leave AIRI_ENABLED=false (default) to run the agent fully standalone.
#   AIRI_WS_URL:   the desktop app embeds the hub on ws://localhost:6121/ws
#   AIRI_WS_TOKEN: AIRI Settings → Connection (QR card), or server-channel-config.json
AIRI_ENABLED=false
AIRI_WS_URL='ws://localhost:6121/ws'
AIRI_MODULE_NAME='factorio'
AIRI_WS_TOKEN=''
