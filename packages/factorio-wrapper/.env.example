FACTORIO_PATH=''
FACTORIO_SAVE_PATH=''
FACTORIO_RCON_PASSWORD=''
FACTORIO_RCON_PORT=27015
# Optional: a config.ini whose [path] write-data points to a dedicated dir, so the
# headless server doesn't fight the desktop client over %APPDATA%/Factorio/.lock.
FACTORIO_CONFIG_PATH=''
# Optional: a server-settings.json with "auto_pause": false so the dedicated server keeps
# ticking with no client connected (lets `pnpm --filter ...agent test:rcon` run headless).
# See packages/factorio-wrapper/server-settings.example.json.
FACTORIO_SERVER_SETTINGS_PATH=''

WS_SERVER_PORT=8080
WS_SERVER_HOST=''
